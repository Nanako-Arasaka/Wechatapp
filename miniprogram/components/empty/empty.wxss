.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  box-sizing: border-box;
}

.empty-icon-box {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #F4F6F9;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-emoji {
  font-size: 64rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2329;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #86909C;
  text-align: center;
  margin-bottom: 32rpx;
  line-height: 1.5;
}

.empty-container .empty-btn {
  width: auto;
  min-width: 0;
  margin: 0;
  line-height: 1.5;
  background: #1677FF;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 36rpx;
  padding: 12rpx 40rpx;
  border: none;
}
