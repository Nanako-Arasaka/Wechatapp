@import "./styles/preview-motion.wxss";

/**
 * ============================================================================
 * 全局视觉与样式设计规范 (Design Tokens & Global Styles)
 * ----------------------------------------------------------------------------
 * 核心色板：
 * - 品牌主色：科技蓝 #1677FF (渐变 #1677FF -> #3B82F6)
 * - 成功/空闲：翡翠绿 #00B96B (浅底 #E6FFFB)
 * - 预警/紧张：琥珀橙 #FA8C16 (浅底 #FFF7E6)
 * - 爆满/危险：珊瑚红 #FF4D4F (浅底 #FFF1F0)
 * ============================================================================
 */
page {
  --primary-color: #1677ff;
  --primary-gradient: linear-gradient(135deg, #1677ff 0%, #3b82f6 100%);
  --primary-light: #e6f4ff;
  --primary-glow: rgba(22, 119, 255, 0.28);

  --success-color: #00b96b;
  --success-light: #e6fffb;
  --warning-color: #fa8c16;
  --warning-light: #fff7e6;
  --danger-color: #ff4d4f;
  --danger-light: #fff1f0;

  --text-main: #1d2129;
  --text-regular: #4e5969;
  --text-secondary: #86909c;
  --text-placeholder: #c9cdd4;

  --bg-page: #f6f8fb;
  --bg-white: #ffffff;
  --bg-card: #ffffff;
  --border-color: #e5e6eb;
  --border-light: #f2f3f5;

  --radius-xs: 8rpx;
  --radius-sm: 12rpx;
  --radius-md: 18rpx;
  --radius-lg: 26rpx;
  --radius-xl: 36rpx;
  --radius-pill: 999rpx;

  /* Motion tokens — ui-animation defaults */
  --ease-enter: cubic-bezier(0.22, 1, 0.36, 1);
  --ease-move: cubic-bezier(0.25, 1, 0.5, 1);
  --ease-press: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  --ease-expo: cubic-bezier(0.19, 1, 0.22, 1);
  --dur-press: 120ms;
  --dur-hover: 160ms;
  --dur-ui: 220ms;
  --dur-panel: 280ms;
  --dur-enter: 360ms;

  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  --shadow-card:
    0 6rpx 24rpx rgba(0, 0, 0, 0.04), 0 1rpx 4rpx rgba(0, 0, 0, 0.02);
  --shadow-float: 0 12rpx 36rpx rgba(22, 119, 255, 0.2);
  --shadow-danger: 0 10rpx 30rpx rgba(255, 77, 79, 0.22);
  --shadow-success: 0 10rpx 30rpx rgba(0, 185, 107, 0.22);

  background-color: var(--bg-page);
  color: var(--text-main);
  font-family:
    -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB",
    "Microsoft YaHei", "Segoe UI", Roboto, sans-serif;
  font-size: 28rpx;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

/* 布局通用工具类 */
.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 40rpx;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

/* 卡片基类 */
.card {
  background: var(--bg-white);
  border-radius: var(--radius-lg);
  padding: 30rpx;
  margin: 20rpx 24rpx;
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
  border: 1rpx solid rgba(0, 0, 0, 0.02);
  transition:
    transform var(--dur-press) var(--ease-press),
    box-shadow var(--dur-ui) var(--ease-enter);
}

.card.pressed,
.card:active {
  transform: scale(0.985);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

/* 按钮通用体系 */
.btn-primary {
  background: var(--primary-gradient);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--radius-pill);
  padding: 22rpx 36rpx;
  text-align: center;
  box-shadow: var(--shadow-float);
  border: none;
  transition:
    transform var(--dur-press) var(--ease-press),
    opacity var(--dur-hover) ease,
    box-shadow var(--dur-ui) var(--ease-enter);
}

.btn-primary:active,
.btn-primary.hover-press {
  opacity: 0.92;
  transform: scale(0.97);
  box-shadow: 0 6rpx 18rpx rgba(22, 119, 255, 0.18);
}

.btn-primary.disabled {
  background: #c9cdd4;
  color: #ffffff;
  box-shadow: none;
  cursor: not-allowed;
  transform: none;
  opacity: 1;
}

.btn-outline {
  border: 2rpx solid var(--primary-color);
  color: var(--primary-color);
  background: transparent;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: var(--radius-pill);
  padding: 18rpx 32rpx;
  text-align: center;
  transition:
    background-color var(--dur-hover) ease,
    color var(--dur-hover) ease,
    transform var(--dur-press) var(--ease-press),
    border-color var(--dur-hover) ease;
}

.btn-outline:active,
.btn-outline.hover-press {
  background: var(--primary-light);
  transform: scale(0.97);
}

.btn-danger-outline {
  border: 2rpx solid var(--danger-color);
  color: var(--danger-color);
  background: transparent;
  font-size: 26rpx;
  border-radius: var(--radius-pill);
  padding: 12rpx 24rpx;
  text-align: center;
}

/* 标签体系 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-xs);
  font-size: 22rpx;
  font-weight: 600;
}

.tag-blue {
  background: var(--primary-light);
  color: var(--primary-color);
}

.tag-green {
  background: var(--success-light);
  color: var(--success-color);
}

.tag-orange {
  background: var(--warning-light);
  color: var(--warning-color);
}

.tag-red {
  background: var(--danger-light);
  color: var(--danger-color);
}

.tag-gray {
  background: #f2f3f5;
  color: var(--text-secondary);
}

/* 价格文字规范 */
.price-symbol {
  font-size: 24rpx;
  font-weight: 700;
  color: #ff4d4f;
}

.price-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #ff4d4f;
  letter-spacing: -0.5rpx;
}

.price-unit {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-left: 4rpx;
}

/* 骨架屏动画 */
@keyframes skeleton-shimmer {
  0% {
    background-position: -200px 0;
  }
  100% {
    background-position: calc(200px + 100%) 0;
  }
}

.skeleton-box {
  background: linear-gradient(90deg, #f0f2f5 25%, #e6e8eb 37%, #f0f2f5 63%);
  background-size: 400% 100%;
  animation: skeleton-shimmer 1.4s ease infinite;
  border-radius: 12rpx;
}

.skeleton-card {
  min-height: 140rpx;
}

.skeleton-avatar {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.skeleton-copy {
  flex: 1;
}

.skeleton-line {
  height: 26rpx;
  margin-bottom: 18rpx;
}

.skeleton-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.skeleton-tile {
  width: calc((100% - 32rpx) / 3);
  height: 110rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.skeleton-tile:nth-child(3n) {
  margin-right: 0;
}

@keyframes content-rise {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes selection-pop {
  0% {
    transform: scale(0.94);
  }
  55% {
    transform: scale(1.045);
  }
  100% {
    transform: scale(1);
  }
}

@keyframes selection-ring {
  0% {
    box-shadow: 0 0 0 0 rgba(22, 119, 255, 0.45);
  }
  70% {
    box-shadow: 0 0 0 12rpx rgba(22, 119, 255, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(22, 119, 255, 0);
  }
}

@keyframes fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slide-up {
  from {
    opacity: 0;
    transform: translateY(48rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slide-in-right {
  from {
    opacity: 0;
    transform: translateX(28rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes mask-fade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes sheet-rise {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

@keyframes check-draw {
  0% {
    transform: scale(0.4);
    opacity: 0;
  }
  50% {
    transform: scale(1.12);
    opacity: 1;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes check-stroke {
  0% {
    stroke-dashoffset: 48;
    opacity: 0;
  }
  40% {
    opacity: 1;
  }
  100% {
    stroke-dashoffset: 0;
    opacity: 1;
  }
}

@keyframes pulse-soft {
  0%,
  100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.06);
    opacity: 0.86;
  }
}

@keyframes shimmer-sweep {
  0% {
    transform: translateX(-120%) skewX(-18deg);
  }
  100% {
    transform: translateX(220%) skewX(-18deg);
  }
}

.content-enter {
  animation: content-rise var(--dur-enter) var(--ease-enter) both;
}

.slide-enter {
  animation: slide-up var(--dur-enter) var(--ease-enter) both;
}

.fade-enter {
  animation: fade-in var(--dur-ui) ease both;
}

.pop-on-select {
  animation: selection-pop 280ms var(--ease-enter) both;
}

.ring-on-select {
  animation: selection-ring 480ms var(--ease-enter) both;
}

.delay-short {
  animation-delay: 70ms;
}
.delay-medium {
  animation-delay: 140ms;
}
.delay-long {
  animation-delay: 210ms;
}
.delay-xlong {
  animation-delay: 280ms;
}

/* 按压反馈：配合 hover-class="hover-press" */
.hover-press {
  transform: scale(0.97);
}

/* 高频操作条：入场稍慢、出场快 */
.panel-enter {
  animation: slide-up var(--dur-panel) var(--ease-move) both;
}

/* 成功勾选 */
.success-check-pop {
  animation: check-draw 520ms var(--ease-enter) both;
}

.success-halo {
  animation: pulse-soft 1.6s ease-in-out 0.4s 2;
}

/* 弹层遮罩 / 底部抽屉 */
.mask-enter {
  animation: mask-fade var(--dur-ui) ease both;
}

.sheet-enter {
  animation: sheet-rise var(--dur-panel) var(--ease-move) both;
}

@media (prefers-reduced-motion: reduce) {
  .content-enter,
  .slide-enter,
  .fade-enter,
  .pop-on-select,
  .ring-on-select,
  .panel-enter,
  .success-check-pop,
  .success-halo,
  .skeleton-box {
    animation: none !important;
    opacity: 1;
    transform: none;
  }

  .btn-primary:active,
  .btn-primary.hover-press,
  .btn-outline:active,
  .btn-outline.hover-press,
  .card:active,
  .card.pressed,
  .hover-press {
    transform: none;
  }

  .btn-primary,
  .btn-outline,
  .card {
    transition:
      opacity 100ms linear,
      background-color 100ms linear;
  }
}

/* ============ 通用空状态 / 错误重试占位 ============ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 88rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #86909c;
  text-align: center;
  line-height: 1.6;
}

.btn-retry {
  margin-top: 36rpx;
  padding: 18rpx 64rpx;
  min-height: 44rpx;
  line-height: 44rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  transition:
    transform var(--dur-press) var(--ease-press),
    opacity var(--dur-hover) ease;
}

.btn-retry:active,
.btn-retry.hover-press {
  opacity: 0.88;
  transform: scale(0.96);
}

/* 未读小红点 */
.unread-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff4d4f;
  margin-left: 10rpx;
}

.page-state {
  padding: 64rpx 32rpx;
  color: #687076;
  font-size: 28rpx;
  text-align: center;
}

.page-state button {
  margin-top: 24rpx;
  max-width: 400rpx;
  font-size: 28rpx;
}

button::after {
  border: 0;
}
.btn-primary,
.btn-outline {
  line-height: 1.4;
}
.btn-primary[disabled] {
  background: #c9cdd4;
  color: #fff;
  box-shadow: none;
}
