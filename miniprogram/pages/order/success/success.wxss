.success-page {
  background: #F4F6F9;
  padding: 40rpx 24rpx;
}

.status-top {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36rpx;
  animation: content-rise 420ms var(--ease-enter) both;
}

.success-icon-box {
  width: 120rpx;
  height: 120rpx;
  background: #00B96B;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 185, 107, 0.3);
  margin-bottom: 20rpx;
  animation: check-draw 560ms var(--ease-enter) both;
  position: relative;
}

.success-icon-box::before {
  content: '';
  position: absolute;
  inset: -12rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(0, 185, 107, 0.35);
  animation: pulse-soft 1.8s ease-in-out 0.35s 2;
}

.success-check {
  color: #FFFFFF;
  font-size: 64rpx;
  font-weight: 900;
  animation: check-stroke 480ms var(--ease-enter) 120ms both;
}

.success-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1F2329;
  margin-bottom: 8rpx;
  animation: content-rise 420ms var(--ease-enter) 80ms both;
}

.success-sub {
  font-size: 24rpx;
  color: #86909C;
  animation: content-rise 420ms var(--ease-enter) 140ms both;
}

/* 票券卡片 */
.ticket-card {
  padding: 32rpx;
  border-radius: 28rpx;
  position: relative;
  animation: slide-up 480ms var(--ease-enter) 180ms both;
}

.ticket-type {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2329;
}

.qrcode-wrapper {
  padding: 30rpx 0 16rpx;
}

.qrcode-canvas {
  width: 320rpx;
  height: 320rpx;
  background: #FFFFFF;
}

.code-number-box {
  text-align: center;
  margin-bottom: 24rpx;
}

.code-label {
  font-size: 24rpx;
  color: #86909C;
}

.code-val {
  font-size: 32rpx;
  font-weight: 700;
  color: #1677FF;
  letter-spacing: 2rpx;
}

.ticket-divider {
  position: relative;
  display: flex;
  align-items: center;
  margin: 20rpx -32rpx;
}

.half-circle {
  width: 24rpx;
  height: 48rpx;
  background: #F4F6F9;
}

.half-circle.left {
  border-radius: 0 24rpx 24rpx 0;
}

.half-circle.right {
  border-radius: 24rpx 0 0 24rpx;
}

.dash-line {
  flex: 1;
  height: 2rpx;
  border-bottom: 2rpx dashed #E5E6EB;
}

.ticket-details {
  padding-top: 10rpx;
}

.detail-row {
  font-size: 26rpx;
  padding: 10rpx 0;
}

.d-label {
  color: #86909C;
}

.d-val {
  color: #1F2329;
  font-weight: 500;
}

.text-price {
  color: #FF4D4F;
  font-weight: 700;
  font-size: 30rpx;
}

.actions-box {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-outline-home {
  background: #FFFFFF;
  color: #4E5969;
  border: 2rpx solid #E5E6EB;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 20rpx 0;
}

/* ============== P6 新增样式 ============== */

/* 联系信息卡（入场核验） */
.contact-card {
  padding: 28rpx 30rpx;
  margin-top: 24rpx;
}

.contact-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2329;
  margin-bottom: 16rpx;
}

.contact-card .info-row {
  font-size: 26rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
}

.contact-card .info-row-last {
  border-bottom: none;
}

.contact-card .info-label {
  color: #86909C;
  flex-shrink: 0;
}

.contact-card .info-value {
  color: #1F2329;
  font-weight: 500;
  text-align: right;
  max-width: 480rpx;
  word-break: break-all;
}

/* 查看场地位置按钮（复用全局 .btn-primary 渐变） */
.btn-location {
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 1rpx;
}

