.fill-page {
  background: #f6f8fb;
  padding: 12rpx 8rpx calc(180rpx + env(safe-area-inset-bottom));
}

/* 订单摘要卡 */
.summary-card {
  padding: 28rpx 30rpx;
  margin-bottom: 24rpx;
}

.summary-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
  margin-bottom: 20rpx;
}

.summary-row {
  font-size: 26rpx;
  padding: 12rpx 0;
}

.summary-label {
  color: #86909c;
}

.summary-value {
  color: #1f2329;
  font-weight: 500;
  max-width: 480rpx;
  text-align: right;
}

.summary-divider {
  height: 1rpx;
  background: #e5e6eb;
  margin: 12rpx 0;
}

.summary-total {
  padding: 8rpx 0 0;
}

.summary-value-total {
  color: #ff4d4f;
  font-weight: 700;
  font-size: 32rpx;
}

/* 联系信息表单卡 */
.form-card {
  padding: 28rpx 30rpx;
}

.form-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
  margin-bottom: 20rpx;
}

.form-row {
  font-size: 28rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  color: #1f2329;
  width: 140rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  min-width: 0;
  text-align: right;
  color: #1f2329;
  font-size: 28rpx;
}

.form-placeholder {
  color: #c9cdd4;
  font-size: 26rpx;
}

/* 底部固定栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.btn-next {
  width: 100%;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 24rpx 0;
}

.btn-disabled {
  opacity: 0.5;
}

/* ===== 身份选择 ===== */
.identity-group {
  display: flex;
  align-items: center;
  gap: 28rpx;
}
.identity-opt {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-main);
}
.identity-opt radio {
  transform: scale(0.8);
  margin-right: 4rpx;
  transform-origin: center;
}

/* ===== 表单提示 ===== */
.form-tip {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  padding-bottom: 8rpx;
}
