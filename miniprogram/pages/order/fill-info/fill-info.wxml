<view class="fill-page container">

  <view class="summary-card card motion-panel">
    <view class="summary-title">订单摘要</view>
    <view class="summary-row flex-between">
      <text class="summary-label">场馆</text>
      <text class="summary-value">{{venueName}}</text>
    </view>
    <view class="summary-row flex-between">
      <text class="summary-label">场地</text>
      <text class="summary-value">{{courtNo ? courtNo + '号场' : '主场地'}}</text>
    </view>
    <view class="summary-row flex-between">
      <text class="summary-label">日期</text>
      <text class="summary-value">{{date}}</text>
    </view>
    <view class="summary-row flex-between">
      <text class="summary-label">时间</text>
      <text class="summary-value">{{timeRange}}</text>
    </view>
    <view class="summary-row flex-between">
      <text class="summary-label">数量</text>
      <text class="summary-value">{{quantity}} 个名额</text>
    </view>
    <view class="summary-divider"></view>
    <view class="summary-row flex-between summary-total">
      <text class="summary-label">合计</text>
      <text class="summary-value-total">¥{{(unitPrice * quantity) / 100}}</text>
    </view>
  </view>

  <!-- 预约人身份（校内 / 校外） -->
  <view class="form-card card motion-panel delay-short">
    <view class="form-title">预约人信息（入场核验用）</view>

    <view class="form-row">
      <text class="form-label">身份</text>
      <radio-group class="identity-group" bindchange="onIdentityChange">
        <label class="identity-opt">
          <radio value="STUDENT" checked="{{identityType === 'STUDENT'}}" color="#1677FF" />
          <text>在校生</text>
        </label>
        <label class="identity-opt">
          <radio value="VISITOR" checked="{{identityType === 'VISITOR'}}" color="#1677FF" />
          <text>校外人员</text>
        </label>
      </radio-group>
    </view>

    <view class="form-row flex-between">
      <text class="form-label">{{identityType === 'VISITOR' ? '身份证号' : '学号'}}</text>
      <input
        class="form-input"
        value="{{studentNo}}"
        maxlength="18"
        placeholder="{{identityPlaceholder}}"
        placeholder-class="form-placeholder"
        bindinput="onIdentityNoInput"
      />
    </view>
    <view class="form-row flex-between">
      <text class="form-label">姓名</text>
      <input
        class="form-input"
        maxlength="20"
        value="{{contactName}}"
        placeholder="请输入真实姓名"
        placeholder-class="form-placeholder"
        bindinput="onInputName"
      />
    </view>
    <view class="form-row flex-between">
      <text class="form-label">手机号</text>
      <input
        class="form-input"
        type="number"
        maxlength="11"
        value="{{contactPhone}}"
        placeholder="请输入 11 位手机号"
        placeholder-class="form-placeholder"
        bindinput="onInputPhone"
      />
    </view>
  </view>

  <!-- 同行人（解决校外人员进校登记） -->
  <view class="form-card card motion-panel delay-medium">
    <view class="form-title flex-between">
      <text>同行人</text>
      <switch checked="{{companionEnabled}}" bindchange="onToggleCompanion" color="#1677FF" />
    </view>
    <view class="form-tip" wx:if="{{!companionEnabled}}">
      如有校外人员陪同入场，请开启并填写同行人信息
    </view>

    <block wx:if="{{companionEnabled}}">
      <view class="form-row">
        <text class="form-label">身份</text>
        <radio-group class="identity-group" bindchange="onCompanionIdentityChange">
          <label class="identity-opt">
            <radio value="STUDENT" checked="{{companionIdentityType === 'STUDENT'}}" color="#1677FF" />
            <text>在校生</text>
          </label>
          <label class="identity-opt">
            <radio value="VISITOR" checked="{{companionIdentityType === 'VISITOR'}}" color="#1677FF" />
            <text>校外人员</text>
          </label>
        </radio-group>
      </view>
      <view class="form-row flex-between">
        <text class="form-label">{{companionIdentityType === 'VISITOR' ? '身份证号' : '学号'}}</text>
        <input
          class="form-input"
          value="{{companionIdentityNo}}"
          maxlength="18"
          placeholder="{{companionIdentityType === 'VISITOR' ? '请输入身份证号' : '请输入学号'}}"
          placeholder-class="form-placeholder"
          bindinput="onCompanionIdentityNoInput"
        />
      </view>
      <view class="form-row flex-between">
        <text class="form-label">姓名</text>
        <input
          class="form-input"
          maxlength="20"
          value="{{companionName}}"
          placeholder="同行人姓名"
          placeholder-class="form-placeholder"
          bindinput="onCompanionNameInput"
        />
      </view>
      <view class="form-row flex-between">
        <text class="form-label">手机号</text>
        <input
          class="form-input"
          type="number"
          maxlength="11"
          value="{{companionPhone}}"
          placeholder="同行人手机号"
          placeholder-class="form-placeholder"
          bindinput="onCompanionPhoneInput"
        />
      </view>
    </block>
  </view>

  <view class="bottom-bar">
    <button
      class="btn-primary btn-next {{submitting ? 'btn-disabled' : ''}}"
      bindtap="onClickNext"
      disabled="{{submitting}}"
    >
      {{submitting ? '加载中...' : '下一步'}}
    </button>
  </view>
</view>
