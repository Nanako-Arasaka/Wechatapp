<view class="date-picker-page container">
  <view class="card">
    <view class="page-title">选择预约日期</view>
    <view class="day-list">
      <view
        class="day-item {{item.date === currentDate ? 'active' : ''}}"
        wx:for="{{days}}"
        wx:key="date"
        bindtap="onSelectDate"
        data-date="{{item.date}}"
      >
        <text class="day-week">{{item.isToday ? '今天' : item.weekday}}</text>
        <text class="day-date">{{item.date}}</text>
      </view>
    </view>
  </view>
</view>
