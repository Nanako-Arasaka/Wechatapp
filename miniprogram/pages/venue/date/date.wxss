.date-page {
  padding-top: 12rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}
.date-heading-copy {
  min-width: 0;
  flex: 1;
}
.date-title {
  font-size: 30rpx;
  font-weight: 700;
}
.date-subtitle {
  font-size: 23rpx;
  color: #86909c;
  margin-top: 10rpx;
}
.refresh-button {
  flex: none;
  margin: 0 0 0 16rpx;
  padding: 0 20rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  color: #4e5969;
  background: #f4f6f9;
  border-radius: 999rpx;
}
.calendar-card {
  padding: 24rpx 16rpx;
}
.calendar-heading {
  padding: 0 8rpx 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  flex-wrap: wrap;
  gap: 8rpx;
}
.calendar-hint {
  font-size: 20rpx;
  color: #86909c;
  font-weight: 400;
}
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 8rpx;
}
.calendar-weekdays {
  text-align: center;
  font-size: 22rpx;
  color: #86909c;
  margin-bottom: 14rpx;
}
.calendar-cell {
  min-width: 0;
  width: 100%;
  margin: 0;
  padding: 12rpx 0;
  min-height: 168rpx;
  font-size: 26rpx;
  line-height: 1.3;
  border-radius: 18rpx;
  background: #f0f8f5;
  color: #1d2129;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  animation: calendar-in 420ms var(--ease-enter) both;
}
.calendar-empty {
  background: transparent;
  animation: none;
}
.calendar-day {
  font-size: 30rpx;
  font-weight: 700;
}
.calendar-tag {
  height: 28rpx;
  font-size: 18rpx;
  color: #1677ff;
}
.calendar-label {
  color: #86909c;
  font-size: 18rpx;
  margin: 4rpx 0;
}
.calendar-cell.today {
  border-color: #91caff;
}
.calendar-cell.unavailable {
  background: #f0f1f3;
  color: #a8adb5;
}
.calendar-cell.selected {
  background: #e6f4ff;
  border-color: #1677ff;
  box-shadow: 0 8rpx 20rpx rgba(22, 119, 255, 0.15);
  animation: selection-pop 260ms var(--ease-enter) both;
}
.calendar-note {
  margin: 20rpx 8rpx 0;
  color: #86909c;
  font-size: 20rpx;
  line-height: 1.5;
}
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
}
.bottom-action-bar .btn-primary {
  width: 100%;
  margin: 0;
}

@keyframes calendar-in {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@media (prefers-reduced-motion: reduce) {
  .calendar-cell {
    animation: none !important;
  }
}
