.date-picker-page {
  padding: 24rpx;
}
.page-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.day-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.day-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  border-radius: 20rpx;
  background: #f6f8fb;
}
.day-item.active {
  background: #1677ff;
  color: #fff;
}
.day-week {
  font-size: 28rpx;
  font-weight: 600;
}
.day-date {
  font-size: 26rpx;
  opacity: 0.85;
}

/* 预约窗口提示 */
.page-hint {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

/* 每日余量角标 */
.day-remaining {
  display: block;
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}
.day-item.active .day-remaining {
  color: rgba(255, 255, 255, 0.85);
}

/* 闭馆/约满置灰 */
.day-item.disabled {
  opacity: 0.45;
}
