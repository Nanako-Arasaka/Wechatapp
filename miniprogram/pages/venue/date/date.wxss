.date-picker-page {
  padding: 24rpx;
}
.page-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.day-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.day-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  border-radius: 20rpx;
  background: #f6f8fb;
}
.day-item.active {
  background: #1677ff;
  color: #fff;
}
.day-week {
  font-size: 28rpx;
  font-weight: 600;
}
.day-date {
  font-size: 26rpx;
  opacity: 0.85;
}
