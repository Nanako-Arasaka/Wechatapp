.court-page {
  padding-top: 12rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}
.card {
  margin: 24rpx 32rpx;
  border-radius: 30rpx;
}
.summary-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.summary-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  font-size: 25rpx;
  color: #86909c;
  padding: 17rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
}
.summary-row:last-child {
  border: 0;
}
.summary-row text:last-child {
  color: #1d2129;
  text-align: right;
  max-width: 75%;
  overflow-wrap: break-word;
}
.summary-row .summary-price {
  color: #fa8c16;
}
.court-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx;
}
.legend {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.legend text {
  background: #f4f6f9;
  color: #86909c;
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
}
.legend .available-label {
  background: #e6fffb;
  color: #00b96b;
}
.court-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18rpx;
}
.court-page .court-cell {
  display: block;
  min-width: 0;
  width: 100%;
  padding: 28rpx 8rpx;
  margin: 0;
  line-height: 1.4;
  background: #e6fffb;
  color: #087b58;
  border: 2rpx solid rgba(0, 185, 107, 0.35);
  border-radius: 26rpx;
  box-sizing: border-box;
  transition:
    transform 120ms ease,
    background-color 220ms ease,
    border-color 220ms ease;
}
.court-page .court-cell.unavailable {
  background: #f0f1f3;
  border-color: #e5e6eb;
  color: #86909c;
}
.court-page .court-cell.selected {
  background: #e6f4ff;
  border-color: #1677ff;
  color: #1677ff;
  animation:
    selection-pop 420ms var(--ease-enter) both,
    selection-ring 720ms var(--ease-enter) both;
}
.court-no {
  font-size: 29rpx;
  font-weight: 700;
}
.court-status {
  font-size: 21rpx;
  margin-top: 8rpx;
}
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
}
.bottom-action-bar .btn-primary {
  width: 100%;
  margin: 0;
}

@media (prefers-reduced-motion: reduce) {
  .court-page .court-cell {
    animation: none !important;
    transition: none;
  }
}
