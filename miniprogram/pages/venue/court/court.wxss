/**
 * ============================================================================
 * P3 可选场地页样式
 * ----------------------------------------------------------------------------
 * 布局：顶部已选时段摘要 + 底部弹窗弹层（场地色块网格 + 【下一步】）。
 * 色块规则：绿色 = 可预约；灰色 = 不可预约；主色描边 + ✓ 角标 = 已选中。
 * ============================================================================
 */

/* 页面容器 */
.court-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

/* ===== 顶部已选时段摘要 ===== */
.summary-area {
  padding-top: 20rpx;
}

.summary-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--primary-color);
  margin-bottom: 16rpx;
}

.summary-row {
  margin-bottom: 12rpx;
}

.summary-row:last-child {
  margin-bottom: 0;
}

.summary-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.summary-value {
  font-size: 26rpx;
  color: var(--text-main);
  font-weight: 600;
}

.summary-price {
  color: var(--warning-color);
}

/* 已选场地高亮 */
.summary-court {
  color: var(--success-color);
}

/* ===== 底部弹窗弹层 ===== */
/* 弹层背后半透明遮罩 */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  opacity: 0;
  transition: opacity 0.25s ease;
  pointer-events: none;
  z-index: 20;
}

.sheet-mask.show {
  opacity: 1;
}

/* 弹层主体：固定于页面底部，入场时自下而上滑出 */
.court-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-white);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.28s ease;
  z-index: 21;
}

.court-sheet.show {
  transform: translateY(0);
}

/* 顶部把手装饰条 */
.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  background: var(--border-color);
  border-radius: var(--radius-pill);
  margin: 0 auto 20rpx;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

/* ===== 色块图例 ===== */
.legend-bar {
  margin: 20rpx 0;
}

.legend-item {
  margin-right: 40rpx;
  font-size: 24rpx;
  color: var(--text-regular);
}

.legend-box {
  width: 28rpx;
  height: 28rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
}

.legend-green {
  background: var(--success-light);
  border: 2rpx solid rgba(0, 185, 107, 0.45);
}

.legend-gray {
  background: #F0F1F3;
  border: 2rpx solid var(--border-color);
}

/* ===== 场地色块网格 ===== */
.court-grid-scroll {
  max-height: 46vh;
}

.court-grid {
  display: flex;
  flex-wrap: wrap;
}

/* 单块场地：一行三列 */
.court-cell {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  padding: 24rpx 0;
  text-align: center;
  border-radius: var(--radius-md);
  box-sizing: border-box;
  transition: all 0.15s ease;
}

/* 每行第 3 个去掉右间距 */
.court-cell:nth-child(3n) {
  margin-right: 0;
}

/* 绿色 = 可预约 */
.court-cell.available {
  background: var(--success-light);
  border: 2rpx solid rgba(0, 185, 107, 0.45);
}

/* 灰色 = 不可预约 */
.court-cell.unavailable {
  background: #F0F1F3;
  border: 2rpx solid var(--border-color);
}

/* 选中态：主色描边 + 轻微上浮 */
.court-cell.selected {
  background: var(--primary-light);
  border-color: var(--primary-color);
  box-shadow: var(--shadow-float);
  animation: selection-pop 260ms ease-out;
}

.court-no {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

.court-cell.unavailable .court-no {
  color: var(--text-placeholder);
}

.court-cell.selected .court-no {
  color: var(--primary-color);
}

.court-status {
  font-size: 22rpx;
  color: var(--success-color);
  margin-top: 8rpx;
}

.court-cell.unavailable .court-status {
  color: var(--text-placeholder);
}

.court-cell.selected .court-status {
  color: var(--primary-color);
  font-weight: 600;
}

/* 选中标记：右上角 ✓ 角标 */
.court-check {
  position: absolute;
  top: -12rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: var(--primary-color);
  color: #FFFFFF;
  font-size: 24rpx;
  border-radius: 50%;
  box-shadow: var(--shadow-float);
}

/* ===== 弹层底部操作区 ===== */
.sheet-footer {
  margin-top: 24rpx;
}

.btn-next {
  background: var(--primary-gradient);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: var(--radius-pill);
  padding: 22rpx 0;
  text-align: center;
  border: none;
  box-shadow: var(--shadow-float);
}

/* 未选场地时的置灰态 */
.btn-next.disabled {
  background: #C9CDD4;
  box-shadow: none;
}

.btn-next:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* ===== 加载 / 空数据提示 ===== */
.loading-box {
  padding: 80rpx 0;
  text-align: center;
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}
