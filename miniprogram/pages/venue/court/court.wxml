<view class="court-page container">
  <view class="summary-card card motion-panel">
    <view class="summary-title">已选时段</view>
    <view class="summary-row"><text>场馆</text><text>{{venueName}}</text></view>
    <view class="summary-row"><text>日期</text><text>{{date}}</text></view>
    <view class="summary-row"><text>时间段</text><text>{{timeRange}}</text></view>
    <view class="summary-row"><text>单价</text><text class="summary-price">{{priceText}}</text></view>
  </view>
  <view wx:if="{{loading}}" class="card skeleton-card"><view class="skeleton-box skeleton-line" style="width:48%"></view><view class="skeleton-grid"><view class="skeleton-box skeleton-tile" wx:for="{{6}}" wx:key="*this"></view></view></view>
  <view wx:elif="{{loadError}}" class="empty-state"><view class="empty-title">场地状态加载失败</view><button class="btn-retry" bindtap="onRetry">点击重试</button></view>
  <view wx:elif="{{!courts.length}}" class="empty-state"><view class="empty-title">暂无可选场地</view><view class="empty-desc">{{unavailableReason || '请刷新后再试'}}</view><button class="btn-retry" bindtap="onRetry">重新加载</button></view>
  <view wx:else class="card motion-panel delay-short">
    <view class="court-heading"><view class="summary-title">请选择场地</view><view class="legend"><text class="available-label">✓ 可预约</text><text>满 / 占用</text></view></view>
    <view class="court-grid">
      <button class="court-cell {{item.available ? 'available' : 'unavailable'}} {{item.selected ? 'selected' : ''}}" wx:for="{{courts}}" wx:key="no" bindtap="onSelectCourt" data-no="{{item.no}}" aria-label="{{item.no}}号场 {{item.available ? '可预约' : '已占用'}}">
        <view class="court-no">{{item.no}}号场</view><view class="court-status">{{item.selected ? '✓ 已选' : item.available ? '✓ 可预约' : '× 已占用'}}</view>
      </button>
    </view>
  </view>
  <view class="bottom-action-bar"><button class="btn-primary" disabled="{{navigating || loading || loadError || !selectedCourtNo}}" bindtap="goToFillInfo">下一步 · 填写信息</button></view>
</view>
