<wxs src="../../../utils/filters.wxs" module="filters" />
<view class="venue-detail-page container">
  <view wx:if="{{loading}}" class="card skeleton-box" style="height:380rpx"></view>
  <view wx:elif="{{loadError}}" class="empty-state"><view class="empty-title">场馆信息加载失败</view><button class="btn-retry" bindtap="onRetry">点击重试</button></view>
  <block wx:elif="{{venue.id}}">
    <image class="detail-hero motion-detail" src="{{coverImage}}" mode="aspectFill" binderror="onImageError" />
    <view class="detail-intro motion-detail">
      <view class="detail-name">{{venue.name}}</view>
      <view class="detail-muted">{{venue.address}}</view>
      <view class="detail-muted">营业时间 {{venue.openTime}}-{{venue.closeTime}}</view>
    </view>
    <view class="card motion-detail delay-short">
      <view class="card-section-title">场馆介绍</view><view class="detail-muted">{{venue.description || '场馆介绍暂未提供'}}</view>
      <view class="detail-facilities"><text wx:for="{{venue.facilities}}" wx:key="*this">{{item}}</text></view>
    </view>
    <view class="card motion-detail delay-medium">
      <view class="card-section-title">场馆信息</view>
      <view class="detail-fact"><text>今日余量</text><text>{{venue.totalRemaining === undefined || venue.totalRemaining === null ? '待查询' : venue.totalRemaining + ' 个名额'}}</text></view>
      <view class="detail-fact"><text>开放时间</text><text>{{venue.openTime}}-{{venue.closeTime}}</text></view>
      <view class="detail-fact"><text>起订价</text><text>¥{{filters.formatMoney(venue.basePrice)}}/小时</text></view>
      <view class="detail-fact"><text>场地类型</text><text>{{filters.venueTypeName(venue.type)}}</text></view>
    </view>
    <view class="card motion-detail delay-long">
      <view class="card-section-title">馆内平面示意图</view>
      <view class="map-entrance">↑ 场馆入口 / 前台</view>
      <view class="map-grid"><view class="map-court" wx:for="{{courtBlocks}}" wx:key="no">{{item.no}}号场</view></view>
      <view class="detail-muted">示意图仅供参考，实际布局以场馆现场为准。</view>
    </view>
    <view class="card" wx:if="{{venue.rules}}"><view class="card-section-title">预约须知</view><view class="detail-muted">{{venue.rules}}</view></view>
    <view class="bottom-action-bar"><view class="detail-price">¥{{filters.formatMoney(venue.basePrice)}}<text>/小时起</text></view><button class="btn-primary" bindtap="goToBooking">开始预约</button></view>
  </block>
  <view wx:else class="empty-state"><view class="empty-title">暂无场馆信息</view><button class="btn-retry" bindtap="onRetry">重新加载</button></view>
</view>
