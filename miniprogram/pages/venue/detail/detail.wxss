.venue-detail-page {
  padding: 30rpx 0 calc(180rpx + env(safe-area-inset-bottom));
}
.detail-hero {
  display: block;
  width: calc(100% - 64rpx);
  height: 370rpx;
  margin: 0 32rpx;
  border-radius: 32rpx;
  background: #e5e6eb;
}
.detail-intro {
  margin: 26rpx 32rpx;
}
.detail-name {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
  margin-bottom: 12rpx;
}
.detail-muted {
  font-size: 24rpx;
  line-height: 1.7;
  color: #86909c;
}
.card {
  margin: 24rpx 32rpx;
  border-radius: 28rpx;
}
.card-section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.detail-facilities {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}
.detail-facilities text {
  font-size: 22rpx;
  padding: 7rpx 14rpx;
  border-radius: 10rpx;
  color: #4e5969;
  background: #f4f6f9;
}
.detail-fact {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
  font-size: 26rpx;
  color: #4e5969;
}
.detail-fact:last-child {
  border: 0;
}
.map-entrance {
  padding: 18rpx;
  text-align: center;
  font-size: 23rpx;
  color: #86909c;
}
.map-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin: 12rpx 0 22rpx;
}
.map-court {
  padding: 28rpx 0;
  border: 2rpx solid #b7e6d0;
  background: #e6fffb;
  border-radius: 12rpx;
  text-align: center;
  color: #087b58;
  font-size: 24rpx;
}
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 28rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
}
.detail-price {
  color: #ff4d4f;
  font-size: 38rpx;
  font-weight: 800;
}
.detail-price text {
  color: #86909c;
  font-size: 21rpx;
  font-weight: 400;
}
.bottom-action-bar button {
  flex: 1;
  margin: 0;
}
