<view class="venue-list-page container">
  <view class="search-header">
    <view class="search-input-box flex-row {{searchFocused ? 'focus' : ''}}">
      <image class="ui-icon" src="/assets/ui/search.svg" />
      <input class="search-input flex-1" placeholder="搜索场地名称、项目或地址" value="{{keyword}}" bindinput="onKeywordInput" bindconfirm="onSearchConfirm" bindfocus="onSearchFocus" bindblur="onSearchBlur" confirm-type="search" focus="{{autoFocus}}" />
      <button class="clear-btn" bindtap="onClearKeyword">清除</button>
    </view>
    <scroll-view class="type-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="type-item {{currentType === item.key ? 'active' : ''}}" wx:for="{{typeList}}" wx:key="key" bindtap="onSelectType" data-key="{{item.key}}" hover-class="hover-press">{{item.name}}</view>
    </scroll-view>
    <view class="sort-bar flex-row">
      <view class="sort-item {{sortBy === 'RECOMMEND' ? 'active' : ''}}" bindtap="onSelectSort" data-sort="RECOMMEND">综合推荐</view>
      <view class="sort-item {{sortBy === 'PRICE_ASC' ? 'active' : ''}}" bindtap="onSelectSort" data-sort="PRICE_ASC">价格最优</view>
      <view class="sort-item {{sortBy === 'REMAIN_DESC' ? 'active' : ''}}" bindtap="onSelectSort" data-sort="REMAIN_DESC">余量充裕</view>
    </view>
  </view>
  <view class="venue-results">
    <view wx:if="{{loading}}" class="skeleton-wrap"><view class="card skeleton-box" style="height:240rpx"></view><view class="card skeleton-box" style="height:240rpx"></view></view>
    <view wx:elif="{{loadError}}" class="empty-state"><view class="empty-title">场地列表加载失败</view><view class="empty-desc">请检查网络后重试</view><button class="btn-retry" bindtap="onRetry">点击重试</button></view>
    <view wx:else class="venue-cards-list" style="{{listStyle}}">
      <empty wx:if="{{!venueList.length && !filterAnimating}}" title="暂无匹配场地" description="试试其他关键词或运动项目" btnText="重置筛选" bindbtnTap="onResetFilter" />
      <view class="venue-card-shell" wx:for="{{venueList}}" wx:key="id" data-id="{{item.id}}" style="{{cardStyles[item.id] || ''}}">
        <venue-card venue="{{item}}" bind:open="goToDetail" bind:book="goToBooking" />
      </view>
    </view>
  </view>
</view>
