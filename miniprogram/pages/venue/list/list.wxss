.search-header {
  padding: 32rpx 32rpx 12rpx;
}
.search-input-box {
  gap: 14rpx;
  background: #fff;
  border: 2rpx solid rgba(22, 119, 255, 0.12);
  border-radius: 999rpx;
  padding: 14rpx 14rpx 14rpx 28rpx;
  transition:
    box-shadow 220ms ease,
    border-color 220ms ease,
    transform 120ms ease;
}
.search-input-box.focus {
  border-color: rgba(22, 119, 255, 0.45);
  box-shadow: 0 8rpx 28rpx rgba(22, 119, 255, 0.16);
  transform: translateY(-2rpx);
}
.search-input {
  min-width: 0;
  font-size: 24rpx;
}
.clear-btn {
  flex: none;
  margin: 0;
  padding: 0 24rpx;
  font-size: 24rpx;
  line-height: 64rpx;
  color: #fff;
  background: #1677ff;
  border-radius: 999rpx;
}
.type-scroll {
  white-space: nowrap;
  margin-top: 18rpx;
}
.type-item {
  display: inline-block;
  margin: 8rpx 14rpx 14rpx 0;
  padding: 20rpx 30rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #4e5969;
  background: #f4f6f9;
  border-radius: 999rpx;
  transition:
    background-color 220ms ease,
    color 220ms ease,
    transform 120ms ease;
}
.type-item.active {
  background: #1677ff;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.2);
  transform: scale(1.03);
}
.sort-bar {
  justify-content: space-between;
  margin: 4rpx 0 10rpx;
}
.sort-item {
  padding: 12rpx 8rpx;
  font-size: 22rpx;
  color: #86909c;
}
.sort-item.active {
  color: #1677ff;
}
.venue-cards-list {
  padding: 0 32rpx;
  transition:
    opacity 240ms ease,
    transform 240ms ease;
}
.filter-leaving {
  opacity: 0.15;
  transform: translateY(14rpx);
  pointer-events: none;
}
.venue-card-shell {
  position: relative;
}
@media (prefers-reduced-motion: reduce) {
  .venue-cards-list,
  .type-item,
  .search-input-box {
    transition: none;
  }
  .filter-leaving {
    transform: none;
  }
}
