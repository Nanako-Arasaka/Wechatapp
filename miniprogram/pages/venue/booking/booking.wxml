<view class="booking-page container">
  <!-- 场馆信息概览：馆名 + 地址 -->
  <view class="venue-brief card flex-row content-enter" wx:if="{{!loading && !loadError}}">
    <image class="v-brief-img" src="{{venue.coverImage}}" mode="aspectFill" />
    <view class="v-brief-info flex-1">
      <view class="v-brief-name">{{venue.name}}</view>
      <view class="v-brief-addr">{{venue.address}}</view>
    </view>
  </view>

  <!-- 日期标题：仅支持当天预约 -->
  <view class="date-title card flex-between content-enter delay-short" wx:if="{{!loading && !loadError}}">
    <view>
      <view class="dst-main">选择预约时段</view>
      <view class="dst-sub">今日 {{todayText}}</view>
    </view>
    <view class="tag tag-blue">仅支持当天</view>
  </view>

  <!-- 加载骨架屏 -->
  <view wx:if="{{loading}}">
    <view class="card skeleton-card flex-row">
      <view class="skeleton-box skeleton-avatar"></view>
      <view class="skeleton-copy"><view class="skeleton-box skeleton-line" style="width: 72%;"></view><view class="skeleton-box skeleton-line" style="width: 94%;"></view></view>
    </view>
    <view class="card skeleton-card">
      <view class="skeleton-box skeleton-line" style="width: 46%;"></view>
      <view class="skeleton-box skeleton-line" style="width: 68%;"></view>
      <view class="skeleton-grid"><view class="skeleton-box skeleton-tile"></view><view class="skeleton-box skeleton-tile"></view><view class="skeleton-box skeleton-tile"></view><view class="skeleton-box skeleton-tile"></view><view class="skeleton-box skeleton-tile"></view><view class="skeleton-box skeleton-tile"></view></view>
    </view>
  </view>

  <!-- 加载失败：错误占位 + 重试 -->
  <view wx:if="{{!loading && loadError}}" class="empty-state">
    <text class="empty-icon">📡</text>
    <text class="empty-title">时段加载失败</text>
    <text class="empty-desc">网络似乎不太给力，请稍后重试</text>
    <view class="btn-retry" bindtap="onRetry">点击重试</view>
  </view>

  <!-- 闭馆提示 -->
  <view class="closed-box card" wx:if="{{!loading && !loadError && isClosed}}">
    <text class="closed-text">今日场馆闭馆：{{closedReason || '暂不开放预约'}}</text>
  </view>

  <!-- 小时格子时间选择组件 -->
  <view class="slot-grid card content-enter delay-medium" wx:if="{{!loading && !loadError && !isClosed && slots.length > 0}}">
    <view
      class="slot-cell {{item.isSelectable ? '' : 'disabled'}} {{selectedSlotId === item.id ? 'selected' : ''}}"
      wx:for="{{slots}}"
      wx:key="id"
      bindtap="onSelectSlot"
      data-slot="{{item}}"
    >
      <!-- 时段文字 -->
      <view class="slot-time">{{item.startTime}}</view>
      <view class="slot-range">{{item.startTime}}-{{item.endTime}}</view>
      <!-- 状态文字：可预约显示余量，不可预约显示原因（颜色之外补充图标语义） -->
      <view class="slot-status">{{item.isSelectable ? '✓ ' + item.statusText : item.statusText === '已过时段' ? '— 已过' : item.statusText === '已满' ? '满' : '× ' + item.statusText}}</view>
    </view>
  </view>

  <!-- 今日无时段兜底 -->
  <view class="loading-box" wx:if="{{!loading && !loadError && !isClosed && slots.length === 0}}">
    <text class="loading-text">今日暂无可预约时段</text>
  </view>

  <!-- 选中时段摘要信息 -->
  <view class="summary-card card content-enter" wx:if="{{!loading && !loadError && selectedSlot}}">
    <view class="summary-title">已选时段</view>
    <view class="summary-row flex-between">
      <text class="summary-label">场馆</text>
      <text class="summary-value">{{venue.name}}</text>
    </view>
    <view class="summary-row flex-between">
      <text class="summary-label">日期</text>
      <text class="summary-value">{{todayText}}</text>
    </view>
    <view class="summary-row flex-between">
      <text class="summary-label">时间段</text>
      <text class="summary-value">{{selectedSlot.timeRange}}（1小时）</text>
    </view>
    <view class="summary-row flex-between">
      <text class="summary-label">单价</text>
      <text class="summary-value summary-price">{{selectedPriceText}}</text>
    </view>
  </view>

  <!-- 底部固定操作栏：【下一步】跳转 P3 可选场地页 -->
  <view class="bottom-action-bar">
    <button class="btn-next {{selectedSlot && !loading && !loadError ? '' : 'disabled'}}" bindtap="goToCourtSelect" disabled="{{navigating || loading || loadError || !selectedSlot}}">{{navigating ? '跳转中...' : '下一步'}}</button>
  </view>
</view>
