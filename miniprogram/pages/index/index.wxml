<view class="index-page container">
  <view class="header-section">
    <view class="location-row flex-between">
      <view class="loc-left flex-row" bindtap="handleChooseLocation" hover-class="hover-press">
        <image class="ui-icon" src="/assets/ui/location.svg" /><text class="loc-name">{{currentLocation}}</text>
      </view>
      <view class="notify-btn-box" bindtap="goToNotifications" hover-class="hover-press" aria-label="消息通知">
        <image class="ui-icon" src="/assets/ui/bell.svg" /><view class="badge-dot" wx:if="{{hasUnread}}"></view>
      </view>
    </view>
    <view class="search-bar flex-row {{searchFocused ? 'focus' : ''}}">
      <image class="ui-icon" src="/assets/ui/search.svg" />
      <input class="search-input flex-1" value="{{keyword}}" placeholder="搜索运动项目、场馆名称…" confirm-type="search" bindinput="onSearchInput" bindconfirm="onSearchConfirm" bindfocus="onSearchFocus" bindblur="onSearchBlur" />
      <button class="search-btn" bindtap="onSearchConfirm">搜索</button>
    </view>
  </view>
  <view class="home-content">
    <view class="banner-card motion-home" bindtap="navTo" data-url="/pages/venue/list/list" data-type="BADMINTON">
      <image class="banner-photo" src="/assets/venues/badminton.jpg" mode="aspectFill" />
      <view class="banner-shade"></view>
      <view class="banner-copy"><text class="banner-tag">校内场馆</text><view class="banner-title">预约校内体育场馆</view><view class="banner-desc">查看开放时段，选好下一场运动</view></view>
    </view>
    <view class="advice-card motion-home" wx:if="{{!venuesError && !slotsError && !slotsLoading && peakAdvice}}">
      <view class="advice-title">今日错峰建议</view><view class="advice-text">{{peakAdvice}}</view>
    </view>
    <view class="section-header flex-between"><view class="section-title">热门推荐场馆</view><text class="more-link" bindtap="navTo" data-url="/pages/venue/list/list">查看全部 ›</text></view>
    <view wx:if="{{venuesLoading}}"><view class="skeleton-box home-skeleton"></view><view class="skeleton-box home-skeleton"></view></view>
    <view wx:elif="{{venuesError}}" class="empty-state"><view class="empty-title">场馆数据加载失败</view><button class="btn-retry" bindtap="onRetryLoad">点击重试</button></view>
    <view wx:elif="{{!venues.length}}" class="empty-state"><view class="empty-title">暂无可用场馆</view><view class="empty-desc">场馆上架后会在这里显示</view></view>
    <view wx:else>
      <view class="motion-home" wx:for="{{recommendedVenues}}" wx:key="id" style="animation-delay:{{index * 70}}ms">
        <venue-card venue="{{item}}" bind:open="goToVenueDetail" bind:book="goToBooking" />
      </view>
    </view>
    <block wx:if="{{!venuesError && venues.length}}">
      <view class="section-header flex-between"><view class="section-title">今日时段实时余量</view><button class="refresh-slots" bindtap="onRetrySlots" disabled="{{slotsLoading}}"><image class="ui-icon {{slotsLoading ? 'refresh-spin' : ''}}" src="/assets/ui/refresh.svg" />刷新</button></view>
      <scroll-view class="horizontal-scroll" scroll-x show-scrollbar="{{false}}">
        <view class="venue-pill {{selectedVenueId === item.id ? 'active' : ''}}" wx:for="{{venues}}" wx:key="id" bindtap="onSelectQuickVenue" data-id="{{item.id}}">{{item.name}}</view>
      </scroll-view>
      <view wx:if="{{slotsLoading}}" class="skeleton-box slots-skeleton"></view>
      <view wx:elif="{{slotsError}}" class="slots-state"><text>时段余量加载失败</text><button class="btn-retry" bindtap="onRetrySlots">重试</button></view>
      <view wx:elif="{{isClosedToday}}" class="slots-state">今日闭馆：{{closedReason || '场馆维护中'}}</view>
      <scroll-view wx:elif="{{quickSlots.length}}" class="horizontal-scroll" scroll-x show-scrollbar="{{false}}">
        <view class="slot-bubble {{item.isSelectable ? '' : 'disabled'}}" wx:for="{{quickSlots}}" wx:key="id" bindtap="onQuickSlotTap" data-slot="{{item}}">
          <view class="sb-time">{{item.startTime}}</view><view class="sb-status">{{item.isSelectable ? '✓ 余 ' + item.remaining : item.statusText}}</view>
        </view>
      </scroll-view>
      <view wx:else class="slots-state">今日暂无可用时段</view>
    </block>
  </view>
</view>
