.index-page {
  padding-bottom: 50rpx;
}
.header-section {
  background: linear-gradient(180deg, #e6f0ff, #f6f8fb);
  padding: 28rpx 32rpx 32rpx;
}
.location-row {
  margin-bottom: 24rpx;
  gap: 20rpx;
}
.loc-left {
  background: #fff;
  padding: 20rpx 24rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.05);
  max-width: 80%;
  min-width: 0;
  gap: 12rpx;
}
.loc-name {
  min-width: 0;
  font-size: 23rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.notify-btn-box {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  flex: none;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.badge-dot {
  position: absolute;
  top: 12rpx;
  right: 14rpx;
  width: 12rpx;
  height: 12rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
  background: #ff4d4f;
}
.search-bar {
  background: #fff;
  border: 2rpx solid rgba(22, 119, 255, 0.12);
  border-radius: 999rpx;
  padding: 14rpx 14rpx 14rpx 28rpx;
  gap: 16rpx;
  transition:
    box-shadow 220ms ease,
    border-color 220ms ease,
    transform 120ms ease;
}
.search-bar.focus {
  border-color: rgba(22, 119, 255, 0.45);
  box-shadow: 0 8rpx 28rpx rgba(22, 119, 255, 0.16);
  transform: translateY(-2rpx);
}
.search-input {
  min-width: 0;
  font-size: 24rpx;
}
.index-page .search-btn {
  width: auto;
  min-width: 0;
  margin: 0;
  padding: 0 26rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  background: #1677ff;
  color: #fff;
  border-radius: 999rpx;
  flex: none;
  white-space: nowrap;
  box-sizing: border-box;
}
.home-content {
  padding: 0 32rpx;
}
.banner-card {
  position: relative;
  height: 284rpx;
  border-radius: 34rpx;
  overflow: hidden;
  background: #1677ff;
  color: #fff;
  margin-bottom: 26rpx;
}
.banner-photo,
.banner-shade {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
}
.banner-shade {
  background: linear-gradient(
    90deg,
    rgba(8, 35, 65, 0.88),
    rgba(8, 35, 65, 0.15)
  );
}
.banner-copy {
  position: relative;
  padding: 38rpx 40rpx;
}
.banner-tag {
  display: inline-block;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 10rpx;
  padding: 6rpx 12rpx;
  font-size: 21rpx;
}
.banner-title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
  margin: 18rpx 0 12rpx;
}
.banner-desc {
  font-size: 22rpx;
  opacity: 0.92;
}
.advice-card {
  background: #fff;
  border-left: 7rpx solid #fa8c16;
  padding: 26rpx 30rpx;
  border-radius: 26rpx;
}
.advice-title {
  font-size: 27rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.advice-text {
  color: #86909c;
  font-size: 23rpx;
  line-height: 1.6;
}
.section-header {
  margin: 30rpx 0 20rpx;
  gap: 12rpx;
}
.section-title {
  border-left: 7rpx solid #1677ff;
  padding-left: 16rpx;
  font-weight: 700;
  font-size: 29rpx;
}
.more-link {
  color: #86909c;
  font-size: 22rpx;
  flex: none;
}
.home-skeleton {
  height: 230rpx;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
}
.horizontal-scroll {
  white-space: nowrap;
  margin: 14rpx 0;
  width: 100%;
}
.venue-pill {
  display: inline-block;
  margin: 4rpx 14rpx 10rpx 0;
  padding: 17rpx 26rpx;
  border: 2rpx solid #e5e6eb;
  border-radius: 999rpx;
  font-size: 23rpx;
  background: #fff;
  transition:
    background-color 220ms ease,
    color 220ms ease,
    transform 120ms ease;
}
.venue-pill.active {
  background: #1677ff;
  border-color: #1677ff;
  color: #fff;
  transform: scale(1.02);
}
.slot-bubble {
  display: inline-block;
  margin: 4rpx 14rpx 8rpx 0;
  padding: 24rpx 20rpx;
  min-width: 126rpx;
  border: 2rpx solid rgba(0, 185, 107, 0.35);
  border-radius: 26rpx;
  background: #e6fffb;
  text-align: center;
  color: #087b58;
}
.slot-bubble.disabled {
  background: #f0f1f3;
  border-color: #e5e6eb;
  color: #86909c;
}
.sb-time {
  font-weight: 700;
  font-size: 25rpx;
}
.sb-status {
  font-size: 21rpx;
  margin-top: 8rpx;
}
.index-page .refresh-slots {
  width: auto;
  min-width: 0;
  flex: none;
  margin: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 18rpx;
  background: #eef1f5;
  font-size: 23rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  box-sizing: border-box;
}
.slots-skeleton {
  height: 120rpx;
}
.slots-state {
  text-align: center;
  font-size: 24rpx;
  color: #86909c;
  padding: 36rpx;
}
