.profile-page {
  background: #F6F8FB;
  padding-bottom: 60rpx;
}

.user-header {
  background: linear-gradient(135deg, #1677FF 0%, #0958D9 60%, #003EB3 100%);
  padding: 44rpx 32rpx 40rpx;
  color: #FFFFFF;
  border-bottom-left-radius: 36rpx;
  border-bottom-right-radius: 36rpx;
  box-shadow: 0 10rpx 30rpx rgba(22, 119, 255, 0.2);
}

.user-info-row {
  align-items: center;
  margin-bottom: 36rpx;
}

.avatar {
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  margin-right: 22rpx;
  background: #E5E6EB;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.15);
  flex-shrink: 0;
}

.name-line {
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.nickname {
  font-size: 34rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.member-badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(6px);
}

.badge-user {
  background: rgba(255, 255, 255, 0.25);
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.badge-admin {
  background: rgba(250, 140, 22, 0.9);
  color: #FFFFFF;
}

.badge-super {
  background: rgba(245, 158, 11, 0.95);
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 215, 0, 0.8);
}

.phone-text {
  font-size: 22rpx;
  opacity: 0.85;
}

.switch-role-pill {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.2);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-weight: 600;
  backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  gap: 6rpx;
}

.switch-icon {
  font-size: 24rpx;
}

/* 运动数据卡 */
.stats-card {
  background: rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(12px);
  border-radius: 24rpx;
  padding: 26rpx 0;
  border: 1rpx solid rgba(255, 255, 255, 0.25);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.88;
}

.stat-line {
  width: 2rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.25);
}

/* 订单快捷中心卡片 */
.orders-shortcut-card {
  padding: 28rpx;
  margin-top: 20rpx;
  border-radius: 26rpx;
}

.card-header-line {
  margin-bottom: 24rpx;
}

.c-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1D2129;
}

.c-more {
  font-size: 24rpx;
  color: #86909C;
}

.arrow {
  margin-left: 4rpx;
  font-size: 24rpx;
}

.order-types-grid {
  display: flex;
  justify-content: space-around;
}

.ot-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ot-icon-box {
  position: relative;
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  background: #F8FAFC;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
  border: 1rpx solid #F1F5F9;
}

.ot-icon {
  font-size: 40rpx;
}

.ot-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #FF4D4F;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  border: 2rpx solid #FFFFFF;
}

.ot-label {
  font-size: 22rpx;
  color: #4E5969;
  font-weight: 600;
}

/* 管理台卡片 */
.admin-entry-card {
  padding: 30rpx;
  margin-top: 20rpx;
  border-radius: 26rpx;
  border: 1rpx solid rgba(22, 119, 255, 0.15);
}

.admin-title-row {
  margin-bottom: 24rpx;
}

.admin-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1D2129;
}

.admin-badge-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.admin-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.admin-nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
  transition: transform 0.15s ease;
}

.admin-nav-item:active {
  transform: scale(0.92);
}

.a-icon-box {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin-bottom: 10rpx;
}

.bg-blue { background: #E6F4FF; }
.bg-green { background: #E6FFFB; }
.bg-orange { background: #FFF7E6; }
.bg-purple { background: #F9F0FF; }

.a-name {
  font-size: 22rpx;
  font-weight: 700;
  color: #1D2129;
  margin-bottom: 2rpx;
}

.a-desc {
  font-size: 18rpx;
  color: #86909C;
}

/* 常用功能列表 */
.menu-card {
  padding: 10rpx 30rpx;
  margin-top: 20rpx;
  border-radius: 26rpx;
}

.menu-item {
  padding: 28rpx 0;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 18rpx;
}

.menu-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
}

.author-tag {
  font-size: 22rpx;
  color: #1677FF;
  background: #E6F4FF;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 600;
  margin-right: 8rpx;
}

.menu-divider {
  height: 1rpx;
  background: #F4F6F9;
}

.logout-wrap {
  padding: 30rpx 24rpx;
}

.btn-primary-action {
  background: linear-gradient(135deg, #1677FF 0%, #0958D9 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 40rpx;
  padding: 22rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.3);
}

.btn-primary-action:active {
  transform: scale(0.98);
  opacity: 0.95;
}

.btn-logout {
  background: #FFFFFF;
  color: #86909C;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 20rpx 0;
  border: 1rpx solid #E5E6EB;
}
