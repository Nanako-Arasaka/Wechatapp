.login-page {
  min-height: 100vh;
  background: #F4F6F9;
  display: flex;
  flex-direction: column;
}

.login-header {
  background: linear-gradient(135deg, #1677FF 0%, #0958D9 100%);
  padding: 60rpx 40rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #FFFFFF;
}

.logo-box {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.logo-emoji {
  font-size: 60rpx;
}

.app-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.app-slogan {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
}

.badge-tag {
  background: rgba(255, 255, 255, 0.25);
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 30rpx;
  font-weight: 500;
}

.login-card {
  margin-top: -40rpx;
  border-radius: 32rpx;
  padding: 36rpx;
  background: #FFFFFF;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2329;
  margin-bottom: 8rpx;
}

.card-subtitle {
  font-size: 24rpx;
  color: #86909C;
  margin-bottom: 30rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.f-label {
  display: block;
  font-size: 26rpx;
  color: #4E5969;
  margin-bottom: 10rpx;
}

.f-input {
  height: 84rpx;
  background: #F8F9FB;
  border: 2rpx solid #EDEFF2;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1F2329;
}

.btn-login {
  background: #1677FF;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 24rpx 0;
  margin-top: 16rpx;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(22, 119, 255, 0.25);
}

.btn-login:active {
  opacity: 0.9;
}

.demo-hint {
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
  padding: 16rpx;
  background: #F2F3F5;
  border-radius: 12rpx;
}

.demo-hint text {
  font-size: 22rpx;
  color: #86909C;
  line-height: 1.6;
}

.divider-row {
  display: flex;
  align-items: center;
  margin: 32rpx 0 24rpx;
}

.divider-line {
  flex: 1;
  height: 2rpx;
  background: #E5E6EB;
}

.divider-text {
  font-size: 22rpx;
  color: #86909C;
  padding: 0 20rpx;
}

.btn-wechat {
  background: #07C160;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 0;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(7, 193, 96, 0.25);
}

.btn-wechat:active {
  opacity: 0.9;
}

.wechat-hint-text {
  text-align: center;
  font-size: 22rpx;
  color: #86909C;
  margin-top: 16rpx;
}

.wx-icon {
  font-size: 32rpx;
}

.login-footer {
  text-align: center;
  padding: 40rpx 20rpx;
  font-size: 22rpx;
  color: #86909C;
  margin-top: auto;
}
