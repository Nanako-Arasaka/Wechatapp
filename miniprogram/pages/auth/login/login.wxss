.login-page {
  min-height: 100vh;
  background: #f6f8fb;
}
.login-header {
  padding: 90rpx 46rpx 68rpx;
  border-radius: 0 0 54rpx 54rpx;
  color: #fff;
  background: linear-gradient(160deg, #1677ff 0%, #3b82f6 55%, #60a5fa 100%);
}
.badge-tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 12rpx;
  font-size: 22rpx;
}
.app-title {
  font-size: 50rpx;
  font-weight: 700;
  margin: 24rpx 0 16rpx;
}
.app-slogan {
  font-size: 24rpx;
  line-height: 1.7;
  opacity: 0.92;
}
.login-card {
  margin: 32rpx;
  padding: 32rpx;
  border-radius: 30rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 26rpx;
}
.form-item {
  margin-bottom: 24rpx;
}
.f-input {
  width: 100%;
  box-sizing: border-box;
  height: 94rpx;
  border-radius: 22rpx;
  background: #f4f6f9;
  padding: 0 30rpx;
  font-size: 26rpx;
}
.btn-login,
.btn-wechat {
  display: block;
  width: 100%;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  line-height: 1.4;
  padding: 25rpx 20rpx;
  transition: transform 120ms ease;
}
.btn-login {
  display: block;
  width: 100%;
  background: #1677ff;
  color: #fff;
}
.btn-wechat {
  margin-top: 20rpx;
  background: #fff;
  color: #1677ff;
  border: 2rpx solid #1677ff;
}
.btn-login[disabled],
.btn-wechat[disabled] {
  opacity: 0.5;
}
.btn-login:active,
.btn-wechat:active {
  transform: scale(0.97);
}
.login-hint {
  font-size: 23rpx;
  color: #86909c;
  line-height: 1.6;
  margin-top: 28rpx;
}
.login-footer {
  text-align: center;
  font-size: 22rpx;
  color: #86909c;
  padding: 36rpx 0;
}
