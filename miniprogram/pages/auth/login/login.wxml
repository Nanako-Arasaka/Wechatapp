<view class="login-page">
  <view class="login-header motion-login">
    <text class="badge-tag">智场通 SmartVenue</text>
    <view class="app-title">校园场馆预约</view>
    <view class="app-slogan">查看实时余量 · 在线预约 · 扫码入场</view>
    <view class="app-slogan">登录后即可预约羽毛球、篮球、游泳等场地</view>
  </view>
  <view class="login-card card motion-login delay-short">
    <view class="card-title">学工号登录</view>
    <view class="form-item"><input class="f-input" placeholder="请输入学工号 / 账号" value="{{username}}" bindinput="onUsernameInput" aria-label="学工号或账号" /></view>
    <view class="form-item"><input class="f-input" password placeholder="请输入密码" value="{{password}}" bindinput="onPasswordInput" bindconfirm="handleLogin" confirm-type="done" aria-label="密码" /></view>
    <button class="btn-login" bindtap="handleLogin" loading="{{submitting}}" disabled="{{submitting}}">登录</button>
    <button class="btn-wechat" bindtap="handleWechatLogin" disabled="{{submitting}}">微信登录（演示）</button>
    <view class="login-hint">暂无账号？请联系体育场馆管理中心。正式预约请使用学工号登录。</view>
  </view>
  <view class="login-footer">© 2026 SmartVenue 智场通</view>
</view>
