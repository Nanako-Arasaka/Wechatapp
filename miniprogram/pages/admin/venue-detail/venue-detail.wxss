/* 单场馆管理详情。视觉沿用全局设计令牌，不引入新的色板。 */
.venue-detail-page {
  background: var(--bg-page);
}

/* ===== 场馆头图：与用户端详情页一致的处理方式 ===== */
.vd-hero {
  position: relative;
  height: 320rpx;
}
.vd-cover {
  width: 100%;
  height: 100%;
  background: var(--border-light);
}
.vd-hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(to top, rgba(29, 33, 41, 0.78), rgba(29, 33, 41, 0) 62%);
}
.vd-hero-copy {
  position: absolute;
  left: 32rpx;
  right: 180rpx;
  bottom: 32rpx;
}
.vd-name {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  color: #ffffff;
}
.vd-meta {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-top: 10rpx;
}
.vd-status {
  position: absolute;
  right: 32rpx;
  bottom: 32rpx;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
}
.vd-status.is-open {
  background: var(--success-light);
  color: var(--success-color);
}
.vd-status.is-off {
  background: rgba(255, 255, 255, 0.9);
  color: var(--text-secondary);
}

/* ===== 场馆信息 ===== */
.info-card {
  margin: 24rpx 32rpx 0;
  padding: 4rpx 28rpx;
}
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}
.info-row:last-child {
  border-bottom: none;
}
.info-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}
.info-value {
  font-size: 26rpx;
  color: var(--text-main);
  text-align: right;
  margin-left: 28rpx;
}

/* ===== 区块标题 ===== */
.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

/* ===== 操作宫格 ===== */
.action-grid {
  display: flex;
  margin: 0 32rpx;
  gap: 16rpx;
}
.action-item {
  flex: 1;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 28rpx 24rpx;
  box-shadow: var(--shadow-card);
  transition: transform var(--dur-press) var(--ease-press);
}
.action-item.hover-press {
  transform: scale(0.98);
}
.ac-icon-box {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.ac-icon-box.is-success {
  background: var(--success-light);
}
.ac-icon-box.is-primary {
  background: var(--primary-light);
}
.ac-icon {
  width: 42rpx;
  height: 42rpx;
}
.ac-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}
.ac-desc {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

/* ===== 运营操作列表 ===== */
.op-card {
  margin: 0 32rpx 40rpx;
  padding: 4rpx 28rpx;
}
.op-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border-light);
}
.op-row:last-child {
  border-bottom: none;
}
.op-row.hover-press {
  opacity: 0.7;
}
.op-label {
  font-size: 28rpx;
  color: var(--text-main);
}
.op-value {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.op-value.danger {
  color: var(--danger-color);
}
.op-arrow {
  font-size: 34rpx;
  color: var(--text-placeholder);
}

.venue-detail-page .empty-state {
  margin: 0 32rpx;
}
.loading-box {
  padding: 96rpx 0;
  text-align: center;
  color: var(--text-secondary);
  font-size: 26rpx;
}
