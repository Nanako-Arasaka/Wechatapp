.venue-detail-page {
  background: #F4F6F9;
}

/* ===== 场馆头图 ===== */
.vd-hero {
  position: relative;
  height: 320rpx;
  margin-bottom: 20rpx;
}
.vd-cover {
  width: 100%;
  height: 100%;
  background: #F2F3F5;
}
.vd-hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
  background: linear-gradient(to top, rgba(31, 35, 41, 0.75), rgba(31, 35, 41, 0) 60%);
}
.vd-hero-copy {
  position: absolute;
  left: 28rpx;
  bottom: 28rpx;
  right: 160rpx;
}
.vd-name {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  color: #FFFFFF;
}
.vd-meta {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 8rpx;
}
.vd-status {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}
.vd-status.tag-green {
  background: #E8FFEA;
  color: #00994D;
}
.vd-status.tag-gray {
  background: rgba(255, 255, 255, 0.9);
  color: #86909C;
}

/* ===== 场馆信息 ===== */
.info-card {
  padding: 8rpx 24rpx;
  margin-bottom: 8rpx;
}
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
}
.info-row:last-child {
  border-bottom: none;
}
.info-label {
  font-size: 26rpx;
  color: #86909C;
  flex-shrink: 0;
}
.info-value {
  font-size: 26rpx;
  color: #1F2329;
  text-align: right;
  margin-left: 24rpx;
}

/* ===== 区块标题 ===== */
.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 28rpx 4rpx 16rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2329;
}

/* ===== 操作宫格 ===== */
.action-grid {
  display: flex;
  gap: 16rpx;
}
.action-item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.05);
}
.ac-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin-bottom: 14rpx;
}
.ac-icon.bg-green {
  background: #E8FFEA;
}
.ac-icon.bg-blue {
  background: #E6F4FF;
}
.ac-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2329;
}
.ac-desc {
  display: block;
  font-size: 22rpx;
  color: #86909C;
  margin-top: 4rpx;
}

/* ===== 运营操作列表 ===== */
.op-card {
  padding: 0 24rpx;
}
.op-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
}
.op-row:last-child {
  border-bottom: none;
}
.op-label {
  font-size: 28rpx;
  color: #1F2329;
}
.op-value {
  font-size: 24rpx;
  color: #86909C;
}
.op-value.danger {
  color: #FF4D4F;
}
.op-arrow {
  font-size: 36rpx;
  color: #C9CDD4;
}

.loading-box {
  padding: 80rpx 0;
  text-align: center;
  color: #86909C;
  font-size: 26rpx;
}
