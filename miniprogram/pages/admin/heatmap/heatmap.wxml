<view class="heatmap-page container">
  <view class="hm-header card">
    <view class="hm-title">场馆时段热力图</view>

    <!-- 色阶图例 -->
    <view class="hm-scale-bar flex-row">
      <text class="scale-label">空闲</text>
      <view class="scale-box s-1"></view>
      <view class="scale-box s-2"></view>
      <view class="scale-box s-3"></view>
      <view class="scale-box s-4"></view>
      <view class="scale-box s-5"></view>
      <text class="scale-label">爆满</text>
    </view>
  </view>

  <!-- 热力网格卡片 -->
  <view class="page-state" wx:if="{{loading}}">正在加载热力图...</view>
  <view class="page-state" wx:elif="{{loadError}}">
    <text>热力图加载失败</text>
    <button bindtap="loadHeatmap">重试</button>
  </view>
  <view class="page-state" wx:elif="{{rows.length === 0}}">暂无时段数据</view>
  <scroll-view scroll-x wx:else>
  <view class="hm-matrix-card card" style="min-width:640px;">
    <!-- 横向时段表头 -->
    <view class="matrix-row header-row flex-row">
      <view class="day-cell header">星期</view>
      <view class="hour-cell header flex-1" wx:for="{{hours}}" wx:key="*this">{{item}}</view>
    </view>

    <!-- 每天的数据行 -->
    <view class="matrix-row flex-row" wx:for="{{rows}}" wx:for-item="row" wx:key="day">
      <view class="day-cell">{{row.day}}</view>
      <view
        class="hour-cell flex-1 cell-val flex-center"
        wx:for="{{row.cells}}"
        wx:for-item="cell"
        wx:key="hour"
        style="background: {{cell.background}}; color: {{cell.color}};"
        bindtap="onCellTap"
        data-day="{{row.day}}"
        data-hour="{{cell.hour}}"
        data-val="{{cell.value}}"
      >
        <text class="cell-num">{{cell.value}}%</text>
      </view>
    </view>
  </view>
  </scroll-view>
</view>
