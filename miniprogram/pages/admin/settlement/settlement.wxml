<view class="settlement-page container">
  <view class="page-state" wx:if="{{loading}}">正在加载结算数据...</view>
  <view class="page-state" wx:elif="{{loadError}}">
    <text>结算数据加载失败</text>
    <button bindtap="loadData">重试</button>
  </view>
  <block wx:else>
  <!-- 资金核心总览大卡 -->
  <view class="settlement-header card">
    <view class="sh-title flex-between">
      <text class="sh-label">今日净收入 (元)</text>
      <text class="tag {{kpi.todayIncomeGrowth >= 0 ? 'tag-green' : 'tag-red'}}">{{kpi.todayIncomeGrowth >= 0 ? '+' : ''}}{{kpi.todayIncomeGrowth}}% 较昨日</text>
    </view>
    <view class="sh-amount-box flex-row">
      <text class="sh-currency">¥</text>
      <text class="sh-amount">{{kpi.todayNetIncome}}</text>
    </view>
    <view class="sh-sub-row flex-between">
      <text class="yesterday-text">昨日净收入：¥{{kpi.yesterdayNetIncome}}</text>
      <text class="settle-rule-tag">模拟结算</text>
    </view>
  </view>

  <!-- 4 个资金指标卡 -->
  <view class="money-grid">
    <view class="m-card card">
      <view class="m-label">本月累计收入</view>
      <view class="m-val">¥{{kpi.monthRevenue}}</view>
    </view>
    <view class="m-card card">
      <view class="m-label">历史总营收</view>
      <view class="m-val font-blue">¥{{kpi.totalRevenue}}</view>
    </view>
    <view class="m-card card">
      <view class="m-label">待结算资金</view>
      <view class="m-val font-orange">¥{{kpi.pendingSettlement}}</view>
    </view>
    <view class="m-card card">
      <view class="m-label">累计退款金额</view>
      <view class="m-val font-danger">¥{{kpi.totalRefunds}}</view>
    </view>
  </view>

  <!-- 7天营收趋势图 -->
  <view class="chart-card card">
    <view class="chart-header flex-between">
      <view class="c-title-box flex-row">
        <text class="c-bar"></text>
        <text class="c-title">近 7 天实际营收走势</text>
      </view>
      <text class="tag tag-blue">日结走势</text>
    </view>
    <view class="canvas-wrap">
      <canvas id="settleTrendCanvas" canvas-id="settleTrendCanvas" class="trend-chart-canvas"></canvas>
    </view>
  </view>

  <!-- 场馆营收结构占比 -->
  <view class="chart-card card">
    <view class="chart-header flex-between">
      <view class="c-title-box flex-row">
        <text class="c-bar"></text>
        <text class="c-title">各场馆营收来源占比</text>
      </view>
      <text class="tag tag-green">收入结构</text>
    </view>
    <view class="canvas-wrap">
      <canvas id="settlePieCanvas" canvas-id="settlePieCanvas" class="pie-chart-canvas"></canvas>
    </view>
  </view>

  <!-- 结算规则说明 -->
  <view class="info-note-card card">
    <view class="note-title">结算说明</view>
    <view class="note-item">当前支付与退款为模拟交易，不产生实际资金收付。</view>
  </view>
  </block>
</view>
