/* 管理端落地页。视觉沿用全局设计令牌与动效类，不引入新的色板。 */
.admin-home {
  background: var(--bg-page);
}

/* ===== 顶部身份条：沿用用户端深色头部的处理方式 ===== */
.home-header {
  background: linear-gradient(135deg, #1f2329 0%, #2c3138 100%);
  padding: 32rpx 32rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.header-role {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.role-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
}
.role-tag {
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
}
.header-exit {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.14);
  transition: background var(--dur-press) var(--ease-press);
}
.header-exit.hover-press {
  background: rgba(255, 255, 255, 0.24);
}
.header-exit .ui-icon {
  width: 28rpx;
  height: 28rpx;
}
.header-exit-text {
  font-size: 22rpx;
  color: #ffffff;
}

/* ===== 区块标题 ===== */
.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}
.section-count {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ===== 场馆管理卡（核心）===== */
.venue-manage-card {
  display: flex;
  align-items: center;
  margin: 0 32rpx 20rpx;
  padding: 24rpx;
}
.vm-cover {
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--radius-md);
  background: var(--border-light);
  flex-shrink: 0;
}
.vm-body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}
.vm-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.vm-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.vm-status {
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: var(--radius-pill);
  flex-shrink: 0;
}
.vm-status.is-open {
  background: var(--success-light);
  color: var(--success-color);
}
.vm-status.is-off {
  background: var(--border-light);
  color: var(--text-secondary);
}
.vm-meta {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}
.vm-arrow {
  font-size: 36rpx;
  color: var(--text-placeholder);
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ===== 快捷操作：与用户端订单宫格一致的两列 ===== */
.quick-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
  gap: 16rpx;
}
.quick-item {
  width: calc((100% - 16rpx) / 2);
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 28rpx 24rpx;
  box-shadow: var(--shadow-card);
  transition: transform var(--dur-press) var(--ease-press);
}
.quick-item.hover-press {
  transform: scale(0.98);
}
.q-icon-box {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.q-icon-box.is-success {
  background: var(--success-light);
}
.q-icon-box.is-warning {
  background: var(--warning-light);
}
.q-icon {
  width: 42rpx;
  height: 42rpx;
}
.q-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}
.q-desc {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 运营分析入口 ===== */
.dashboard-entry {
  display: flex;
  align-items: center;
  margin: 32rpx 32rpx 40rpx;
  padding: 32rpx 28rpx;
  background: var(--primary-gradient);
  box-shadow: var(--shadow-float);
  transition: transform var(--dur-press) var(--ease-press);
}
.dashboard-entry.hover-press {
  transform: scale(0.98);
}
.dashboard-entry .de-title,
.dashboard-entry .de-desc {
  color: #ffffff;
}
.de-left {
  flex: 1;
  min-width: 0;
}
.de-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
}
.de-desc {
  display: block;
  font-size: 24rpx;
  opacity: 0.82;
  margin-top: 8rpx;
}
.dashboard-entry .ui-icon {
  width: 40rpx;
  height: 40rpx;
}

/* ===== 空态与加载 ===== */
.admin-home .empty-state {
  margin: 0 32rpx;
}
.loading-box {
  padding: 96rpx 0;
  text-align: center;
  color: var(--text-secondary);
  font-size: 26rpx;
}
