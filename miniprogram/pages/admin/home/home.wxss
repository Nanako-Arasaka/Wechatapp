.admin-home {
  background: #F4F6F9;
}

/* ===== 顶部身份条 ===== */
.home-header {
  background: #1F2329;
  padding: 28rpx 32rpx 36rpx;
  margin-bottom: 20rpx;
}
.header-role {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.role-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
}
.role-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  color: #FFFFFF;
}
.role-tag.tag-green {
  background: #00B96B;
}
.role-tag.tag-purple {
  background: #722ED1;
}
.header-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.65);
}

/* ===== 区块标题 ===== */
.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 24rpx 4rpx 16rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2329;
}
.section-count {
  font-size: 24rpx;
  color: #86909C;
}

/* ===== 场馆管理卡（核心） ===== */
.venue-manage-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  gap: 20rpx;
}
.vm-cover {
  width: 132rpx;
  height: 132rpx;
  border-radius: 16rpx;
  background: #F2F3F5;
  flex-shrink: 0;
}
.vm-body {
  flex: 1;
  min-width: 0;
}
.vm-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.vm-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2329;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.vm-status {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}
.vm-status.tag-green {
  background: #E8FFEA;
  color: #00994D;
}
.vm-status.tag-gray {
  background: #F2F3F5;
  color: #86909C;
}
.vm-meta,
.vm-time {
  display: block;
  font-size: 24rpx;
  color: #86909C;
  margin-top: 6rpx;
}
.vm-arrow {
  font-size: 40rpx;
  color: #C9CDD4;
  flex-shrink: 0;
}

/* ===== 快捷操作 ===== */
.quick-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.quick-item {
  width: calc((100% - 32rpx) / 2);
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.05);
}
.q-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 14rpx;
}
.q-icon.bg-purple {
  background: #F4ECFF;
}
.q-icon.bg-green {
  background: #E8FFEA;
}
.q-icon.bg-blue {
  background: #E6F4FF;
}
.q-icon.bg-orange {
  background: #FFF7E8;
}
.q-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2329;
}
.q-desc {
  display: block;
  font-size: 22rpx;
  color: #86909C;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 运营分析入口 ===== */
.dashboard-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 28rpx 24rpx;
}
.de-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2329;
}
.de-desc {
  display: block;
  font-size: 24rpx;
  color: #86909C;
  margin-top: 6rpx;
}

.loading-box {
  padding: 80rpx 0;
  text-align: center;
  color: #86909C;
  font-size: 26rpx;
}
